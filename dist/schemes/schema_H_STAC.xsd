      <xs:element name="MOP"       type="xs:integer"/>
      <xs:element name="NHISTORY"  type="xs:string"/>
      <xs:element name="P_PER"     type="xs:integer" minOccurs="0"/>
      <xs:element name="DATE_1"    type="xs:date"/>
      <xs:element name="DATE_2"    type="xs:date"/>
