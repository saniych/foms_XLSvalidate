      <xs:element name="OS_SLUCH" type="xs:integer" minOccurs="0"/>
      <xs:element name="VB_P"     type="xs:integer" minOccurs="0"/>
      <xs:element name="SL"       type="SLType"     maxOccurs="unbounded"/>
      <xs:element name="IDSP"     type="xs:integer"/>
