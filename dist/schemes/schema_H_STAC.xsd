  <!-- ROOT -->

  <xs:element name="ZL_LIST">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ZGLV"  type="ZGLVType"/>
        <xs:element name="SCHET" type="SCHETType"/>
        <xs:element name="ZAP"   type="ZAPType" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ZGLV -->

  <xs:complexType name="ZGLVType">
    <xs:sequence>
      <xs:element name="VERSION">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="6.0"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="DATA"     type="xs:date"/>
      <xs:element name="FILENAME" type="xs:string"/>
      <xs:element name="SD_Z"     type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <!-- SCHET -->

  <xs:complexType name="SCHETType">
    <xs:sequence>
      <xs:element name="CODE"      type="xs:string"/>
      <xs:element name="CODE_MO"   type="xs:string"/>
      <xs:element name="YEAR"      type="xs:integer"/>
      <xs:element name="MONTH"     type="xs:integer"/>
      <xs:element name="NSCHET"    type="xs:string"/>
      <xs:element name="DSCHET"    type="xs:date"/>
      <xs:element name="PLAT"      type="xs:string"/>
      <xs:element name="SUMMAV"    type="xs:decimal"/>
      <xs:element name="COMENTS"   type="xs:string"/>
      <xs:element name="SUMMAP"    type="xs:decimal"/>
